{
  "expo": {
    "name": "وعد",
    "slug": "waad",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#3B1826",
    "splash": {
      "backgroundColor": "#3B1826"
    },
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.waad.app",
      "infoPlist": {
        "NSMicrophoneUsageDescription": "يحتاج وعد إلى الميكروفون للتحدث في الغرف الصوتية."
      }
    },
    "android": {
      "package": "com.waad.app",
      "permissions": ["RECORD_AUDIO", "MODIFY_AUDIO_SETTINGS"]
    }
  }
}
